---
import Layout from '../layouts/Layout.astro';
import Diagram from '../components/Diagram.astro';
import { getCollection } from 'astro:content';
import { pathTo } from '../lib/paths';
const selected = (await getCollection('work')).sort((first, second) => first.data.order - second.data.order).filter(entry => entry.data.featured).slice(0, 3);
---
<Layout title="Home">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> Engineer · Technical lead · Research-minded</p>
      <h1>Systems are complex.<br /><span>Make them work<br />for people.</span></h1>
      <p class="hero-description">I’m Salimullah. I build the data pipelines, integrations, and operational workflows that people depend on—and investigate what happens when they don’t work as expected.</p>
      <a class="button" href={pathTo('work/')}>View my engineering work <span aria-hidden="true">↗</span></a>
      <p class="hero-location">Technical Services Lead, Data & Integrations<br /><strong>JustGo Technologies</strong> <span aria-hidden="true">/</span> Based in Bangladesh</p>
    </div>
    <aside class="hero-aside" aria-label="Professional perspective">
      <div class="field-label"><span>FIELD NOTES / 2026</span><span aria-hidden="true">↙</span></div>
      <div class="system-sketch" aria-hidden="true">
        <svg viewBox="0 0 360 300" fill="none"><path d="M35 70H132V150H230V65H325M35 235H132V150M230 150V235H325" stroke="currentColor" stroke-width="1.5"/><path d="M230 65V150H325" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 5"/><rect x="13" y="49" width="44" height="42" rx="7"/><rect x="13" y="214" width="44" height="42" rx="7"/><rect x="110" y="128" width="44" height="44" rx="7"/><rect x="208" y="128" width="44" height="44" rx="7"/><circle cx="325" cy="65" r="18"/><circle cx="325" cy="150" r="18"/><circle cx="325" cy="235" r="18"/><circle class="sketch-dot" cx="132" cy="150" r="5"/><circle class="sketch-dot" cx="230" cy="150" r="5"/></svg>
        <span class="sketch-caption">DATA → DECISIONS → PEOPLE</span>
      </div>
      <p class="aside-statement">The interesting part is<br />what happens <em>between</em><br />the systems.</p>
      <div class="aside-bottom"><span>Data integrity<br />Reliable operations<br />Human context</span><span class="corner-symbol" aria-hidden="true">＋</span></div>
    </aside>
  </section>

  <section class="research-strip wrap" aria-labelledby="research-preview">
    <div><p class="eyebrow">For research collaborators</p><h2 id="research-preview">From reliable data systems<br />to trustworthy healthcare AI.</h2></div>
    <div><p>My next research direction connects heterogeneous data, reproducible machine learning, and healthcare. Start with my published work and the questions I want to investigate.</p><a class="text-link" href={pathTo('research/')}>Research & published work <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section wrap" aria-labelledby="selected-work">
    <div class="section-heading"><div><p class="eyebrow">Selected engineering</p><h2 id="selected-work">The work, in detail.</h2></div><a class="text-link" href={pathTo('work/')}>All case studies <span aria-hidden="true">↗</span></a></div>
    {selected.map((entry, index) => <article class:list={['project-feature', { reverse: index % 2 === 1 }]}>
      <div class="project-copy"><p class="eyebrow">{entry.data.category}</p><h3><a href={pathTo(`work/${entry.id}/`)}>{entry.data.title}</a></h3><p>{entry.data.description}</p><p class="contribution"><strong>My contribution</strong><br />{entry.data.role}</p><a class="text-link" href={pathTo(`work/${entry.id}/`)}>Read the case study <span aria-hidden="true">↗</span></a></div>
      <Diagram kind={entry.data.diagram} compact />
    </article>)}
  </section>

  <section class="practice-section">
    <div class="wrap practice-inner"><div><p class="eyebrow">Across the ecosystem</p><h2>Connections with<br />real responsibilities.</h2><p>Integration work includes implementation, investigation, technical consultancy, and delivery. The distinction matters.</p><a class="text-link" href={pathTo('work/#integrations')}>View the contribution index <span aria-hidden="true">↗</span></a></div><div class="vendor-preview">{[['Xero', 'Accounting workflows'], ['Moodle', 'Learning & identity'], ['Dotdigital', 'Data exchange'], ['LearnUpon', 'Learning integration'], ['etrainu', 'SSO & completion data'], ['External APIs', 'Contracts & access']].map(([name, domain]) => <div><strong>{name}</strong><span>{domain}</span></div>)}</div></div>
  </section>

  <section class="section wrap explore-grid">
    <article><p class="eyebrow">Engineering lab</p><h2>Small systems. <br />Visible decisions.</h2><p>Try an original membership-processing sandbox. Inspect validation, identity matching, and row-by-row reconciliation with synthetic data.</p><a class="text-link" href={pathTo('lab/')}>Open the sandbox <span aria-hidden="true">↗</span></a></article>
    <article><p class="eyebrow">Academic foundation</p><h2>Curiosity, backed <br />by commitment.</h2><p>BSc in Computer Science & Engineering at AIUB. Magna Cum Laude, Dean’s List, and academic merit scholarships.</p><a class="text-link" href={pathTo('recognition/')}>Recognition & education <span aria-hidden="true">↗</span></a></article>
  </section>
  <section class="contact-band wrap"><p class="eyebrow">Let’s compare notes</p><h2>Working on a difficult<br />data or research problem?</h2><a class="button" href={pathTo('contact/')}>Start a conversation <span aria-hidden="true">↗</span></a></section>
</Layout>
