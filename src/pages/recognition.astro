---
import Layout from '../layouts/Layout.astro';
import { pathTo } from '../lib/paths';
---
<Layout title="Recognition & education">
  <header class="wrap page-intro"><p class="eyebrow">Recognition / Academic foundation</p><h1>Work that earned<br /><span>its place.</span></h1><p class="lead">Academic achievement, teaching, and competition form part of the foundation I bring to engineering and research.</p></header>
  <section class="wrap degree-feature"><div><p class="eyebrow">American International University–Bangladesh</p><h2>BSc in Computer Science<br />& Engineering</h2><p>Graduated December 2021</p><p class="degree-honour">Magna Cum Laude</p><p class="small">CGPA 3.82 / 4.00 · Academic record reported in my supplied career dossier.</p></div><div class="degree-side"><p class="eyebrow">A sustained commitment</p><h3>Dean’s List & academic merit scholarship</h3><p>Recognition for academic performance during undergraduate study at AIUB. Award dates and certificate images will be added when the original records are prepared for publication.</p></div></section>
  <section class="wrap section recognition-row"><p class="mono small">2022</p><div><p class="eyebrow">Competition</p><h2>Bangladesh Blockchain Olympiad</h2><p>National finalist, as recorded in my career dossier. This is finalist recognition; no winning placement is claimed.</p></div></section>
  <section class="wrap section recognition-row"><p class="mono small">2021</p><div><p class="eyebrow">Teaching & mentoring</p><h2>Helping others work through difficult ideas.</h2><p>Undergraduate teaching assistance in Data Structures and Computer Organization & Architecture, followed by technical mentoring and engineering candidate evaluation in industry.</p><a class="text-link" href={pathTo('about/#experience')}>Read the experience timeline ↗</a></div></section>
  <div class="wrap narrow-note"><p>Recognition entries are grounded in my professional record. Certificates and ceremony photographs are not reproduced until authentic, publication-ready assets are available. <a href={pathTo('evidence/')}>Read about the evidence</a>.</p></div>
</Layout>
