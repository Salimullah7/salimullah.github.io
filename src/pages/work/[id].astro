---
import Layout from '../../layouts/Layout.astro';
import Diagram from '../../components/Diagram.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { pathTo } from '../../lib/paths';
export async function getStaticPaths() { return (await getCollection('work')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'work'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Layout title={entry.data.title} description={entry.data.description}>
  <header class="wrap case-header"><a class="back-link" href={pathTo('work/')}>← All engineering work</a><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><dl class="case-meta"><div><dt>My contribution</dt><dd>{entry.data.role}</dd></div><div><dt>Context</dt><dd>JustGo Technologies · anonymised customer</dd></div><div><dt>Evidence status</dt><dd>{entry.data.status}</dd></div></dl><div class="tags">{entry.data.stack.map(item => <span>{item}</span>)}</div></header>
  <div class="wrap"><Diagram kind={entry.data.diagram} /></div>
  <div class="wrap article-layout"><aside class="article-nav"><p class="eyebrow">In this case study</p><nav aria-label="Case study contents">{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav><a class="small" href={pathTo('evidence/')}>Evidence & attribution policy ↗</a></aside><article class="prose"><Content /><div class="article-end"><p>Diagrams and validation examples are original educational reconstructions. Production code, customer records, endpoints, and disputed performance figures are excluded.</p><a class="text-link" href={pathTo('lab/')}>Try the independent engineering lab ↗</a></div></article></div>
</Layout>
