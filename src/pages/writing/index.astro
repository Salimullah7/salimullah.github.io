---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { pathTo } from '../../lib/paths';
const posts = await getCollection('writing');
---
<Layout title="Writing"><header class="wrap page-intro"><p class="eyebrow">Writing / Technical notes</p><h1>Notes from<br /><span>between the systems.</span></h1><p class="lead">Original explanations of the data and reliability decisions that tend to hide beneath a successful API response.</p></header><section class="wrap writing-list" aria-label="Technical articles">{posts.map(post => <article><p class="mono small">{post.data.date}<br />{post.data.category}</p><div><h2><a href={pathTo(`writing/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={pathTo(`writing/${post.id}/`)}>Read technical note ↗</a></div></article>)}</section></Layout>
